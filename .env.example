# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.itinfrastructuresolutions.net

# Optional: endpoint that accepts contact form submissions as a JSON POST
# (e.g. a Formspree/Basin/Getform endpoint or your own API).
# When unset, the form validates input and opens a pre-filled email instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=
